# Template only. packaging/build-deb.sh rewrites Exec= and Icon= for where it is
# installing to, so the paths below are never used.
[Desktop Entry]
Name=Crenel
Comment=Choose which project folders your VM can see
Exec=/path/to/access-controller/start.sh
Icon=crenel
Terminal=false
Type=Application
Categories=Utility;System;
StartupWMClass=crenel
